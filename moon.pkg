import {
  "moonbitlang/x/encoding",
  "moonbitlang/core/bench",
  "moonbitlang/core/debug",
}

import {
  "daqing/moon-sqlite3" @sqlite,
} for "test"

warnings = "-6-29-35"

supported_targets = "native+js+wasm"

options(
  link: { "native": { "cc-link-flags": "-lsqlite3" } },
  "native-stub": [ "stub.c" ],
  targets: {
    "ffi_js.mbt": [ "js" ],
    "sqlite_bench.mbt": [ "native" ],
    "sqlite_js.mbt": [ "js" ],
    "sqlite_native.mbt": [ "native" ],
    "sqlite_wasm.mbt": [ "wasm" ],
    "sqlite_wbtest.mbt": [ "native" ],
  },
)
